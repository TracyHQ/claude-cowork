{
  "$schema": "https://developer.joomla.org/schemas/json-schema/web_assets.json",
  "name": "tpl_tracy",
  "version": "0.1.0",
  "description": "Web assets of tpl_tracy. The per-design-system token file (media/css/inspirations/<id>.css) is registered at runtime by index.php, after template.tracy, so its :root values win.",
  "license": "UNLICENSED",
  "assets": [
    {
      "name": "template.tracy",
      "type": "style",
      "uri": "tracy.css"
    },
    {
      "name": "template.layout",
      "type": "style",
      "uri": "layout.css",
      "dependencies": ["template.tracy"]
    },
    {
      "name": "template.sections",
      "type": "style",
      "uri": "sections.css",
      "dependencies": ["template.tracy"]
    },
    {
      "name": "template.tracy",
      "type": "script",
      "uri": "tracy.js",
      "attributes": { "defer": true }
    },
    {
      "name": "template.active",
      "type": "style",
      "dependencies": ["template.tracy", "template.layout", "template.sections"]
    },
    {
      "name": "template.active",
      "type": "script",
      "dependencies": ["template.tracy"]
    }
  ]
}

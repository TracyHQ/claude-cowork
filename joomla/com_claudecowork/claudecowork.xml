<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
    <name>COM_CLAUDECOWORK</name>
    <author>Tracy</author>
    <authorUrl>https://tracy.ai</authorUrl>
    <creationDate>2026-08-10</creationDate>
    <copyright>Copyright (C) 2026 Tracy. All rights reserved.</copyright>
    <!-- GPL because Joomla is: an extension built against Joomla's own API is a derivative
         work of GPL-2.0-or-later code, so this is the licence it has to carry, not one
         chosen from taste. -->
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <version>0.7.1</version>
    <description>COM_CLAUDECOWORK_XML_DESCRIPTION</description>

    <namespace path="src">Tracy\Component\ClaudeCowork</namespace>

    <!-- Seeds a token on install, so installing by hand needs nobody to invent one. -->
    <scriptfile>script.php</scriptfile>

    <!-- Front-end. The API lives here, not under administrator/, on purpose: this endpoint
         authenticates with its own token, and a backend URL would additionally demand a
         Joomla admin session that the caller does not have and should not need.

         Two dispatch styles ship side by side. Joomla 4+ routes through services/provider.php
         and the namespaced src/ controllers; Joomla 3 ignores those and uses the legacy entry
         file claudecowork.php plus controller.php / controllers/, which 4+ ignores in turn.
         Each generation runs the half it understands, over one shared lib/ engine. -->
    <files folder="site">
        <folder>services</folder>
        <folder>src</folder>
        <folder>controllers</folder>
        <filename>claudecowork.php</filename>
        <filename>controller.php</filename>
    </files>

    <administration>
        <files folder="administrator">
            <!-- Joomla 4+ admin dispatch. -->
            <folder>services</folder>
            <folder>src</folder>
            <folder>tmpl</folder>
            <!-- Joomla 3 admin dispatch: the legacy entry, controller and view render the same
                 connect screen. Ignored by Joomla 4+, which uses services/ + src/ above. -->
            <folder>views</folder>
            <filename>claudecowork.php</filename>
            <filename>controller.php</filename>
            <!-- The engine — no Joomla dependency, unit tested on its own. Under
                 administrator/ rather than media/ because media/ is served over HTTP and
                 these are PHP files; same placement Akeeba uses for its own engine. -->
            <folder>lib</folder>
            <filename>config.xml</filename>
        </files>
        <languages folder="administrator/language">
            <language tag="en-GB">en-GB/com_claudecowork.ini</language>
            <language tag="en-GB">en-GB/com_claudecowork.sys.ini</language>
        </languages>
        <!-- Opens the connect screen: the token to copy, and the endpoint it belongs to. -->
        <menu link="option=com_claudecowork">COM_CLAUDECOWORK</menu>
    </administration>

</extension>

    <update>
        <name>Joomla Claude Cowork</name>
        <description>Lets an AI assistant read and, when asked, write this site over one token-authenticated endpoint. files.pack can now hand each part back inline, for a host that cannot open an outbound connection at all; info reports which upload road the host has.</description>
        <element>pkg_claudecowork</element>
        <type>package</type>
        <version>0.8.22</version>
        <infourl title="Release notes">https://github.com/TracyHQ/claude-cowork/releases/tag/joomla-v0.8.22</infourl>

{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": false,
    "layout": {
      "contentSize": "1240px",
      "wideSize": "1240px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        {
          "slug": "bg",
          "name": "Background",
          "color": "#FBFCFA"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#FFFFFF"
        },
        {
          "slug": "surface-warm",
          "name": "Surface warm",
          "color": "#F2F5EE"
        },
        {
          "slug": "fg",
          "name": "Foreground",
          "color": "#46514B"
        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "#10140F"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#7C877F"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "#7C877F"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "#E4E8E0"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "#E4E8E0"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#4D7C0F"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "#FFFFFF"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "#3F6A0A"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "#3F6A0A"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "#30A46C"
        },
        {
          "slug": "warn",
          "name": "Warn",
          "color": "#F5A623"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "#E5484D"
        }
      ]
    },
    "typography": {
      "fluid": false,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"Space Grotesk\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "\"IBM Plex Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "\"JetBrains Mono\", ui-monospace, \"SFMono-Regular\", Menlo, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "12.5px"
        },
        {
          "slug": "sm",
          "name": "SM",
          "size": "14px"
        },
        {
          "slug": "base",
          "name": "Base",
          "size": "16px"
        },
        {
          "slug": "lg",
          "name": "LG",
          "size": "19px"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "23px"
        },
        {
          "slug": "xxl",
          "name": "2XL",
          "size": "28px"
        },
        {
          "slug": "xxxl",
          "name": "3XL",
          "size": "38px"
        },
        {
          "slug": "xxxxl",
          "name": "4XL",
          "size": "52px"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw",
        "vh"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "1",
          "name": "1",
          "size": "4px"
        },
        {
          "slug": "2",
          "name": "2",
          "size": "8px"
        },
        {
          "slug": "3",
          "name": "3",
          "size": "12px"
        },
        {
          "slug": "4",
          "name": "4",
          "size": "16px"
        },
        {
          "slug": "5",
          "name": "5",
          "size": "20px"
        },
        {
          "slug": "6",
          "name": "6",
          "size": "24px"
        },
        {
          "slug": "8",
          "name": "8",
          "size": "32px"
        },
        {
          "slug": "12",
          "name": "12",
          "size": "48px"
        }
      ]
    },
    "custom": {
      "leading": {
        "body": "1.55",
        "tight": "1.04"
      },
      "tracking": {
        "display": "-1.5px"
      },
      "sectionY": {
        "desktop": "80px",
        "tablet": "56px",
        "phone": "56px"
      },
      "radius": {
        "sm": "8px",
        "md": "12px",
        "lg": "16px",
        "pill": "100px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 3px rgba(77, 124, 15, .25)",
        "raised": "0 18px 44px -20px rgba(20, 30, 15, .2)"
      },
      "focusRing": "0 0 0 3px rgba(77, 124, 15, .25)",
      "motion": {
        "fast": "0.15s",
        "base": "0.2s"
      },
      "ease": {
        "standard": "ease"
      },
      "container": {
        "max": "1240px",
        "gutterDesktop": "32px",
        "gutterTablet": "32px",
        "gutterPhone": "20px"
      },
      "tracy": {
        "inspiration": "ja-kinetic"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|bg",
      "text": "var:preset|color|fg"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|base",
      "lineHeight": "var(--wp--custom--leading--body)"
    },
    "spacing": {
      "padding": {
        "top": "0",
        "right": "0",
        "bottom": "0",
        "left": "0"
      },
      "blockGap": "var:preset|spacing|4"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "lineHeight": "var(--wp--custom--leading--tight)",
          "letterSpacing": "var(--wp--custom--tracking--display)"
        },
        "color": {
          "text": "var:preset|color|fg"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|xxxl"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xxl"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|xl"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|fg"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|accent"
          }
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|accent",
          "text": "var:preset|color|accent-on"
        },
        "border": {
          "radius": "var(--wp--custom--radius--md)"
        },
        "typography": {
          "fontWeight": "600"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|accent-hover",
            "text": "var:preset|color|accent-on"
          }
        }
      }
    },
    "css": "/* wp-ja-kinetic: dark mode. The source (JA Kinetic, `default` site style) is dark by default: assets/js/wp-ja-kinetic-dark.js puts data-theme=\"dark\" on the root before the first paint unless the tracy_theme cookie says light, and color-scheme follows it here, as the source's own html does (dark -> `dark`, light -> `normal`). Each colour preset carries both halves through light-dark(): light = the palette of theme.json, dark = the source's html.t4-dark terminal block (css/darkmode.css:1-26, chrome :80-88), with meta, border-soft and accent-active from the design system's dark block (systems/ja-kinetic/tokens.css:367). success, warn and danger are not remapped by the source. The rest of the dark block is not a colour, or is declared by the sections sheet, so it is restated under the attribute. */ :root{--wp--preset--color--bg:light-dark(#FBFCFA,#0A0D0C);--wp--preset--color--surface:light-dark(#FFFFFF,#121614);--wp--preset--color--surface-warm:light-dark(#F2F5EE,#0F1311);--wp--preset--color--fg:light-dark(#46514B,#9AA6A1);--wp--preset--color--fg-2:light-dark(#10140F,#F2F5F3);--wp--preset--color--muted:light-dark(#66716A,#7F8B86);--wp--preset--color--meta:light-dark(#66716A,#7F8B86);--wp--preset--color--border:light-dark(#E4E8E0,#232A27);--wp--preset--color--border-soft:light-dark(#E4E8E0,#232A27);--wp--preset--color--accent:light-dark(#4D7C0F,#A3E635);--wp--preset--color--accent-on:light-dark(#FFFFFF,#0A0D0C);--wp--preset--color--accent-hover:light-dark(#3F6A0A,#BCF25A);--wp--preset--color--accent-active:light-dark(#3F6A0A,#BCF25A);}:root[data-theme=\"dark\"]{color-scheme:dark;--wp--custom--elev--raised:0 20px 50px -18px rgba(0,0,0,.6);--grid:rgba(255,255,255,.035);--bg-rgb:10,13,12;--text-rgb:154,166,161;--chrome-elevated:#161B18;}"
  },

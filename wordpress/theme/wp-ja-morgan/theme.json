      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-masthead-sidebar",
      "title": "Page with masthead and sidebar",
      "postTypes": [
        "page"
      ]
    }
  ],
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    },
    {
      "name": "sidebar",

    "layout": {
      "contentSize": "1024px",
      "wideSize": "1024px"
    },
    "custom": {
      "leading": {
        "body": "1.56",
        "tight": "1.25"
      },
      "tracking": {
        "display": "-0.01em"
      },
      "sectionY": {
        "desktop": "150px",
        "tablet": "64px",
        "phone": "60px"
      },
      "radius": {
        "sm": "8px",
        "md": "4px",
        "lg": "18px",
        "pill": "980px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 12px 32px rgba(0, 0, 0, 0.08)"
      },
      "focusRing": "0 0 0 4px color-mix(in oklab, var(--wp--preset--color--accent), transparent 65%)",
      "motion": {
        "fast": "150ms",
        "base": "220ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.28, 0, 0.22, 1)"
      },
      "container": {
        "max": "1024px",
        "gutterDesktop": "15px",
        "gutterTablet": "18px",
        "gutterPhone": "15px"
      },
      "tracy": {
        "inspiration": "wp-ja-morgan"
      }
    }
  }

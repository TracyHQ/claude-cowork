{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": false,
    "layout": {
      "contentSize": "1320px",
      "wideSize": "1320px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        {
          "slug": "bg",
          "name": "Background",
          "color": "#ffffff"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#fafafa"
        },
        {
          "slug": "surface-warm",
          "name": "Surface warm",
          "color": "#121316"
        },
        {
          "slug": "fg",
          "name": "Foreground",
          "color": "#757575"
        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "#050505"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#757575"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "#86868b"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "#ced4da"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "#e8e8ed"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#1d4ed8"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "#ffffff"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "#0077ed"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "#0066cc"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "#16a34a"
        },
        {
          "slug": "warn",
          "name": "Warn",
          "color": "#eab308"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "#dc2626"
        }
      ]
    },
    "typography": {
      "fluid": false,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"Inter Tight\""
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "\"Inter Tight\""
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "\"SF Mono\", ui-monospace, \"JetBrains Mono\", Menlo, Monaco, Consolas, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "14px"
        },
        {
          "slug": "sm",
          "name": "SM",
          "size": "14px"
        },
        {
          "slug": "base",
          "name": "Base",
          "size": "16px"
        },
        {
          "slug": "lg",
          "name": "LG",
          "size": "18px"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "24px"
        },
        {
          "slug": "xxl",
          "name": "2XL",
          "size": "32px"
        },
        {
          "slug": "xxxl",
          "name": "3XL",
          "size": "48px"
        },
        {
          "slug": "xxxxl",
          "name": "4XL",
          "size": "58px"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw",
        "vh"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "1",
          "name": "1",
          "size": "4px"
        },
        {
          "slug": "2",
          "name": "2",
          "size": "8px"
        },
        {
          "slug": "3",
          "name": "3",
          "size": "12px"
        },
        {
          "slug": "4",
          "name": "4",
          "size": "16px"
        },
        {
          "slug": "5",
          "name": "5",
          "size": "20px"
        },
        {
          "slug": "6",
          "name": "6",
          "size": "24px"
        },
        {
          "slug": "8",
          "name": "8",
          "size": "32px"
        },
        {
          "slug": "12",
          "name": "12",
          "size": "48px"
        }
      ]
    },
    "custom": {
      "leading": {
        "body": "1.5",
        "tight": "1.2"
      },
      "tracking": {
        "display": "0"
      },
      "sectionY": {
        "desktop": "128px",
        "tablet": "64px",
        "phone": "32px"
      },
      "radius": {
        "sm": "8px",
        "md": "8px",
        "lg": "8px",
        "pill": "980px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 12px 32px rgba(0, 0, 0, 0.08)"
      },
      "focusRing": "0 0 0 4px color-mix(in oklab, var(--wp--preset--color--accent), transparent 65%)",
      "motion": {
        "fast": "150ms",
        "base": "150ms"
      },
      "ease": {
        "standard": "ease-in-out"
      },
      "container": {
        "max": "1320px",
        "gutterDesktop": "16px",
        "gutterTablet": "18px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "wp-ja-vega"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|bg",
      "text": "var:preset|color|fg"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|base",
      "lineHeight": "var(--wp--custom--leading--body)"
    },
    "spacing": {
      "padding": {
        "top": "0",
        "right": "0",
        "bottom": "0",
        "left": "0"
      },
      "blockGap": "var:preset|spacing|4"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "lineHeight": "var(--wp--custom--leading--tight)",
          "letterSpacing": "var(--wp--custom--tracking--display)"
        },
        "color": {
          "text": "var:preset|color|fg"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|xxxl"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xxl"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|xl"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|fg"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|accent"
          }
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|accent",
          "text": "var:preset|color|accent-on"
        },
        "border": {
          "radius": "var(--wp--custom--radius--md)"
        },
        "typography": {
          "fontWeight": "600"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|accent-hover",
            "text": "var:preset|color|accent-on"
          }
        }
      }
    },
    "css": "/* wp-ja-vega: dark mode. The source (JA Vega, T4) follows the OS until the visitor picks: its head script sets html[data-theme] from prefers-color-scheme, the .t4-theme-toggle button switches it (css/darkmode.css, js/darkmode.js). Here every colour preset carries both halves through light-dark(): light = tokens.css (measured 26/09 on :8261), dark = the source's --dm-* block (css/darkmode.css:4-5: bg #0f141c, surface #161d28, border #2a323d, text #c7ccd4, heading #f1f3f6, muted #8b94a3, primary #3b8bff, link hover #5fa0ff), each read back as computed style in the M2 design contract (desktop-dark). The footer band is #121316 in both modes, as measured. No attribute = auto, the OS decides; assets/js/wp-ja-vega.js writes data-theme light|dark from the tracy_theme cookie before the first paint. */ :root{color-scheme:light dark;--wp--preset--color--bg:light-dark(#ffffff,#0f141c);--wp--preset--color--surface:light-dark(#fafafa,#161d28);--wp--preset--color--surface-warm:light-dark(#121316,#121316);--wp--preset--color--fg:light-dark(#757575,#c7ccd4);--wp--preset--color--fg-2:light-dark(#050505,#f1f3f6);--wp--preset--color--muted:light-dark(#757575,#8b94a3);--wp--preset--color--meta:light-dark(#86868b,#8b94a3);--wp--preset--color--border:light-dark(#ced4da,#2a323d);--wp--preset--color--border-soft:light-dark(#e8e8ed,#2a323d);--wp--preset--color--accent:light-dark(#1d4ed8,#3b8bff);--wp--preset--color--accent-on:light-dark(#ffffff,#ffffff);--wp--preset--color--accent-hover:light-dark(#0077ed,#5fa0ff);--wp--preset--color--accent-active:light-dark(#0066cc,#3b8bff);}:root[data-theme=\"light\"]{color-scheme:light}:root[data-theme=\"dark\"]{color-scheme:dark}"
  },
  "customTemplates": [
    {
      "name": "landing",
      "title": "Landing",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "fixture",
      "title": "Design system page",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "artifact",
      "title": "Design page (engine)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "pricing",
      "title": "Pricing",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-landing",
      "title": "Landing (masthead and sections)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-contact",
      "title": "Contact",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-service",
      "title": "Service (centred title, other services)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "post-project",
      "title": "Project (masthead, stats, about, gallery, more projects)",
      "postTypes": [
        "post"
      ]
    },
    {
      "name": "page-article",
      "title": "Article (category and date, centred title, related posts)",
      "postTypes": [
        "page",
        "post"
      ]
    }
  ],
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
